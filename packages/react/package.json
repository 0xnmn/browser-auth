{
  "name": "@browser-auth/react",
  "version": "0.1.0",
  "description": "Optional React UI for @browser-auth/core authentication flows",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown && cp src/styles.css dist/styles.css"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@browser-auth/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
