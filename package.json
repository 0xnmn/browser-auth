{
  "name": "browser-auth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "tsc --noEmit",
    "test": "vitest run packages",
    "test:integration": "vitest run tests",
    "test:all": "vitest run",
    "eval": "tsx evals/run.ts",
    "eval:smoke": "tsx evals/run.ts --scripted",
    "preview": "tsx examples/preview.ts",
    "test:package": "tsx tests/package-smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.6.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
